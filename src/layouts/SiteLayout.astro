---
import '../styles/site.css';
import '../styles/changer.css';

interface Props {
	title: string;
	description?: string;
	active?: 'catalog' | 'artists';
}

const {
	title,
	description = 'A personal CD collection, filed by artist and album with changer locations.',
	active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#151715" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to collection</a>
		<header class="site-header">
			<a class="brand" href="/" aria-label="CD Collection home">
				<span class="brand__mark" aria-hidden="true">
					<span></span><span></span><span></span>
				</span>
				<span class="brand__name">CD<span class="brand__slash">/</span><em>collection</em></span>
			</a>
			<span class="header-caption">THE PHYSICAL FORMAT. THE PERSONAL CONNECTION.</span>
			<nav class="primary-nav" aria-label="Main navigation">
				<a href="/" aria-current={active === 'catalog' ? 'page' : undefined}>Collection</a>
				<a href="/artists/" aria-current={active === 'artists' ? 'page' : undefined}>Artists</a>
			</nav>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer">
			<p><span class="footer-disc" aria-hidden="true">◎</span> Less scrolling. More listening.</p>
			<p>
				Cover images via
				<a href="https://musicbrainz.org/doc/Cover_Art_Archive" target="_blank" rel="noreferrer">MusicBrainz Cover Art Archive</a>
			</p>
		</footer>
	</body>
</html>

<script>
	for (const image of document.querySelectorAll<HTMLImageElement>('[data-cover]')) {
		const frame = image.closest('.cover-frame');
		const showFallback = () => {
			image.hidden = true;
			frame?.classList.remove('cover-frame--ready');
			frame?.classList.add('cover-frame--missing');
		};

		image.addEventListener('load', () => frame?.classList.add('cover-frame--ready'), { once: true });
		image.addEventListener('error', showFallback, { once: true });

		if (image.complete) {
			if (image.naturalWidth > 0) frame?.classList.add('cover-frame--ready');
			else showFallback();
		}
	}
</script>
