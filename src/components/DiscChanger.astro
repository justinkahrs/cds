---
import type { AlbumView } from '../lib/catalog';
import { getCoverArtUrl } from '../lib/catalog';
import { slotOrder } from '../lib/carousel.mjs';
interface Props { albums: AlbumView[] }
const albums = [...Astro.props.albums].sort((left, right) => slotOrder(left.changerSlot) - slotOrder(right.changerSlot));
const initialIndex = Math.max(0, albums.findIndex((album) => album.title === 'In Rainbows'));
const initial = albums[initialIndex];
---

<section class="changer" id="disc-changer" aria-label="Interactive CD changer" hidden data-initial-index={initialIndex}>
  <div class="changer-topline">
    <div class="machine-brand">SONY <span>COMPACT DISC CHANGER</span></div>
    <div class="machine-model">CDP-CX355</div>
  </div>
  <div class="machine-window">
    <aside class="selected-album" aria-label="Selected album">
      <div class="vfd-slot"><div class="vfd-label">DISC</div><div class="slot-window lcd-marquee" data-marquee tabindex="0" role="group" aria-label="Disc slot"><span class="marquee-track"><strong id="selected-slot">{initial.changerSlot}</strong><strong class="marquee-copy" id="selected-slot-copy" aria-hidden="true">{initial.changerSlot}</strong></span></div></div>
      <div class="selection-copy" tabindex="0" role="group" aria-label="Selected album information" aria-live="polite" aria-atomic="true"><p><a id="selected-artist" href={initial.artistPath || undefined}>{initial.artist}</a></p><h2 class="title-window lcd-marquee" data-marquee><span class="marquee-track"><a id="selected-title" href={initial.path}>{initial.title}</a><span class="marquee-copy" id="selected-title-copy" aria-hidden="true">{initial.title}</span></span></h2><p class="selected-meta"><span id="selected-year">{initial.releaseYear}</span></p><p class="selected-label" id="selected-label">{initial.label}</p></div>
    </aside>
    <div class="carousel-bay">
      <div class="carousel-stage" id="carousel-stage" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Album carousel. Use left and right arrow keys to browse.">
        <div class="stage-halo" aria-hidden="true"></div>
        <div class="drum" aria-hidden="true"><div class="drum-side"></div><div class="drum-top"><div class="drum-grooves" id="drum-grooves"></div><div class="drum-hub"><span>MEGA<br/><b>STORAGE</b></span><strong>300</strong></div></div></div>
        <div class="carousel-cases" id="carousel-cases">
          {albums.map((album, index) => {
            const cover = getCoverArtUrl(album);
            return <button class="jewel-case" type="button" data-index={index} data-search={`${album.artist ?? ''} ${album.title ?? ''} ${album.changerSlot ?? ''} ${album.label ?? ''} ${album.format ?? ''}`} data-title={album.title || 'Untitled album'} data-artist={album.artist || 'Artist not listed'} data-year={album.releaseYear || '—'} data-label={album.label || 'Label not listed'} data-slot={album.changerSlot || 'Not listed'} data-path={album.path} data-artist-path={album.artistPath || ''} aria-label={`Select ${album.title} by ${album.artist}`} tabindex="-1">
              <span class="jewel-spine" aria-hidden="true"></span>
              <span class="jewel-art"><span class="jewel-fallback"><strong>{album.title || 'Untitled album'}</strong><span>{album.artist}</span></span>{cover && <img src={cover} alt={`Cover artwork for ${album.title}`} loading="lazy" draggable="false" />}</span>
              <span class="jewel-glass" aria-hidden="true"></span>
            </button>;
          })}
        </div>
      </div>
    </div>
  </div>
  <div class="control-deck">
    <div class="storage-brand"><span>MegaStorage</span><strong>300<span>CD</span></strong></div>
    <div class="transport"><div><button type="button" class="hardware-button transport-key" id="previous-disc" aria-label="Previous album"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 5 8 12l10 7z"/></svg></button><button type="button" class="hardware-button transport-key" id="next-disc" aria-label="Next album"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 5l10 7-10 7z"/></svg></button></div></div>
    <div class="shuffle-control"><button class="hardware-button" type="button" id="random-disc" aria-label="Surprise me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c5 0 6 12 11 12h4m-4-4 4 4-4 4M3 18h3c2 0 3-2 4-4m4-4c1-2 2-4 4-4h3m-4-4 4 4-4 4"/></svg></button></div>
    <div class="jog-control"><button type="button" class="jog-dial" id="jog-dial" aria-label="Jog dial: drag to turn, or click for next album"><span class="dial-face"><i></i></span></button></div>
  </div>
  <div class="machine-bottom" aria-hidden="true"></div>
</section>
